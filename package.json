{
  "name": "aio-messenger",
  "productName": "AIO Messenger",
  "version": "0.1.0",
  "description": "All-in-one messaging desktop app for Windows",
  "main": "out/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "author": {
    "name": "AIO Messenger contributors"
  },
  "homepage": "https://github.com/Oldixiq/aio-messaging-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oldixiq/aio-messaging-app.git"
  }
}
